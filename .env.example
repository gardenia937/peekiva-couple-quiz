# Copy this file to .env and fill in your own values.
# This project needs NO payment keys and NO login secrets.
# The only value a developer needs locally is the Worker URL
# so the frontend knows which API to call.

# Local dev: the Worker address (after `wrangler deploy`, or dev server URL)
API_BASE=https://couple-quiz-api.gardenia937.workers.dev

# Cloudflare account for API deployments (never commit the real token)
# Get yours from: dash.cloudflare.com → My Profile → API Tokens
CF_API_TOKEN=
CF_ACCOUNT_ID=
